# ──────────────────────────────────────────────────────────── KS Plastico Demo ────
# Copier ce fichier en `.env.local` et adapter les valeurs.
# Aucun secret ne doit être committé.

# Secret de signature des sessions. OBLIGATOIRE en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Base de données.
# Laisser vide pour utiliser PostgreSQL embarqué (PGlite, fichier .data/pglite).
# Pour un PostgreSQL classique :
# DATABASE_URL=postgres://app:motdepasse@localhost:5432/ks_plastico_demo
# En production, cette base est la mémoire du copilote IA (conversations,
# messages — voir server/db/schema/intelligence.ts et
# server/services/ai-conversations.ts) : héberger l'instance en Europe
# (région du fournisseur Postgres) pour que cette mémoire ne quitte jamais
# l'UE. OpenAI n'est appelé qu'avec `store: false` et ne conserve rien.
#
# ATTENTION : dès que cette valeur pointe vers un hôte distant (Neon, RDS…),
# `npm run db:reset` — destructif — refuse de s'exécuter sans
# APP_ALLOW_RESET=true explicite, même en local. Utiliser une base
# distincte pour le développement et pour la production : ne jamais faire
# pointer un `.env.local` de poste de dev vers la base de production.
DATABASE_URL=

# Confirmation explicite requise par `npm run db:reset` dès que DATABASE_URL
# pointe vers un hôte distant (voir scripts/reset.ts). Ne jamais la mettre en
# dur dans .env.local : la passer en ligne de commande au moment voulu,
# `APP_ALLOW_RESET=true npm run db:reset`.
# APP_ALLOW_RESET=false

# Emplacement du fichier PGlite (optionnel).
# PGLITE_DATA_DIR=

# Amorçage automatique du jeu de démonstration au premier démarrage.
# APP_AUTO_SEED=false

# Appliquer automatiquement les migrations au démarrage (PostgreSQL).
# APP_AUTO_MIGRATE=false

# Secret partagé avec la passerelle ou le simulateur de machines.
# Générer une valeur longue et distincte de AUTH_SECRET.
MACHINE_GATEWAY_SECRET=

# Durée après laquelle un relevé de passerelle est considéré hors ligne.
# MACHINE_TELEMETRY_MAX_AGE_SECONDS=30

# Secret du cron Vercel qui déclenche le moteur de recommandations continu
# (§ vercel.json, server/services/alert-engine.ts). Une fois cette variable
# définie dans les réglages du projet Vercel, la plateforme l'injecte
# automatiquement en `Authorization: Bearer <valeur>` sur l'appel cron — rien
# d'autre à configurer.
#
# Fréquence actuelle : une fois par jour (05:00 UTC), plafond du plan Vercel
# Hobby. Passer à plusieurs exécutions par jour (§ vercel.json, ex. */6 pour
# toutes les 6 h) dès que le projet passe sur un plan supérieur — un bouton
# « Réévaluer maintenant » existe sur /alertes en attendant.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# IA distante (option 1 : OpenAI API).
# La clé reste exclusivement côté serveur.
OPENAI_API_KEY=
# Terra traite toutes les questions en premier ; Sol reste un fallback raisonné.
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
OPENAI_ADVANCED_MODEL=gpt-5.6-sol
# Endpoint standard par défaut. Pour un projet OpenAI configuré avec
# résidence ET processing européens : https://eu.api.openai.com/v1
# OPENAI_BASE_URL=https://eu.api.openai.com/v1
# Effort de raisonnement : none, low, medium, high, xhigh ou max.
# OPENAI_TERRA_REASONING_EFFORT=medium
# OPENAI_SOL_REASONING_EFFORT=high
# Seuil de confiance sous lequel Terra peut demander Sol (garde-fous appliqués).
# OPENAI_SOL_CONFIDENCE_THRESHOLD=0.70
# Plafond observé sur les 100 dernières requêtes, actif après 20 mesures.
# OPENAI_SOL_MAX_SHARE=0.20
# Tarifs USD / million de tokens, surchargeables sans redéploiement du code.
# OPENAI_TERRA_INPUT_USD_PER_MTOK=2
# OPENAI_TERRA_OUTPUT_USD_PER_MTOK=12
# OPENAI_SOL_INPUT_USD_PER_MTOK=5
# OPENAI_SOL_OUTPUT_USD_PER_MTOK=30
# Lorsqu'une IA distante est configurée, le moteur de démonstration n'est
# utilisé en fallback que si ce drapeau est explicitement activé.
# AI_DEMO_FALLBACK_ENABLED=false

# IA distante (option 2, prioritaire si complète : Azure OpenAI).
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://votre-ressource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# ────────────────────────────────────────── Notifications hors-app ────
# Chaque canal est optionnel et indépendant — sans sa configuration, le
# fournisseur correspondant journalise au lieu d'échouer (voir
# server/notifications/*.ts). Un utilisateur ne reçoit un canal que s'il
# l'a explicitement activé depuis « Mon compte → Notifications ».

# URL publique de l'application, utilisée pour construire les liens dans les
# e-mails/SMS/push (sinon http://localhost:3000 par défaut).
# NEXT_PUBLIC_APP_URL=https://demo.example

# E-mail (Resend — https://resend.com, offre gratuite disponible).
# RESEND_EMAIL_API_KEY=
# Adresse d'expédition, doit appartenir à un domaine vérifié sur Resend.
# NOTIFICATION_EMAIL_FROM=alertes@votre-domaine.fr

# SMS (Twilio — https://twilio.com).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+33...

# Notification smartphone (Web Push, RFC 8291) — AUCUN compte tiers requis :
# c'est une simple paire de clés auto-générée, le service push du navigateur
# (Chrome/Firefox/Safari) relaie gratuitement. Générer avec :
#   npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
